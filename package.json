{
  "name": "ratchet",
  "version": "0.0.0",
  "description": "Verify a dependency bump before you merge it: real tests, changelog breaking changes vs. actual usage, bisection to the breaking version.",
  "license": "MIT",
  "type": "module",
  "bin": { "ratchet": "dist/cli/main.js" },
  "files": ["dist"],
  "engines": { "node": ">=24" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test \"dist-test/test/**/*.test.js\""
  },
  "dependencies": { "typescript": "^5.9.0" },
  "devDependencies": { "@types/node": "^24.0.0" }
}
